{
  "name": "FORGE 90",
  "short_name": "FORGE 90",
  "description": "91-day body recomposition: training log, rest timer, day counter and progress trend.",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "display_override": ["standalone", "minimal-ui"],
  "orientation": "portrait",
  "background_color": "#0D1317",
  "theme_color": "#0D1317",
  "categories": ["health", "fitness", "lifestyle"],
  "icons": [
    { "src": "icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "icon-maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "shortcuts": [
    { "name": "Today",    "url": "./#today", "icons": [{ "src": "icon-192.png", "sizes": "192x192" }] },
    { "name": "Train",    "url": "./#train", "icons": [{ "src": "icon-192.png", "sizes": "192x192" }] },
    { "name": "Fuel",     "url": "./#fuel",  "icons": [{ "src": "icon-192.png", "sizes": "192x192" }] },
    { "name": "Progress", "url": "./#prog",  "icons": [{ "src": "icon-192.png", "sizes": "192x192" }] }
  ]
}
